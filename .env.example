# Copy to .env.local. Never commit actual values.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
ADMIN_PASSWORD=
# Set to true ONLY for a read-only demo without Drive.
DEMO_MODE=false

# Cloud Text-to-Speech (ADC, separate from Drive OAuth)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_TTS_VOICE=vi-VN-Standard-A
# Optional for hosting: absolute path to an externally mounted ADC credential file.
# GOOGLE_APPLICATION_CREDENTIALS=
